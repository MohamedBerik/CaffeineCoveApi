{
    "$schema": "https://railway.com/railway.schema.json",
    "build": {
        "builder": "DOCKERFILE"
    },
    "deploy": {
        "startCommand": "apache2-foreground"
    },
    "crons": {
        "schedule-run": {
            "schedule": "* * * * *",
            "command": "php artisan schedule:run"
        }
    }
}
