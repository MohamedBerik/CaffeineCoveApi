{
    "$schema": "https://railway.com/railway.schema.json",
    "build": {
        "builder": "NIXPACKS"
    },
    "deploy": {
        "startCommand": "php artisan serve --host=0.0.0.0 --port=${PORT:-8080}"
    },
    "crons": {
        "schedule-run": {
            "schedule": "* * * * *",
            "command": "php artisan schedule:run"
        }
    }
}
