{
    "build": {
        "builder": "NIXPACKS"
    },
    "services": {
        "CaffeineCoveApi": {
            "startCommand": "php artisan serve --host=0.0.0.0 --port=$PORT"
        },
        "worker": {
            "startCommand": "php artisan queue:work database --sleep=3 --tries=3 --timeout=90"
        }
    }
}