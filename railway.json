{
    "$schema": "https://railway.com/railway.schema.json",
    "build": {
        "builder": "NIXPACKS",
        "nixpacks": {
            "config": {
                "php": {
                    "version": "8.2"
                }
            }
        }
    },
    "crons": {
        "schedule-run": {
            "schedule": "* * * * *",
            "command": "php artisan schedule:run"
        }
    }
}
